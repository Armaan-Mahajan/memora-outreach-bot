<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.armaan.memora-outreach-push</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/armaanmahajan/Documents/Projects/Memora/outreach-bot/scripts/auto-push.sh</string>
    </array>

    <!-- Runs every 15 minutes. Adjust to taste -- this just needs to be
         more frequent than you care about the delay between a local commit
         landing and it showing up on GitHub. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/armaanmahajan/Library/Logs/memora-outreach-push.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/armaanmahajan/Library/Logs/memora-outreach-push.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
