<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.armaan.memora-outreach-push</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/armaanmahajan/Documents/Projects/Memora/outreach-bot/scripts/auto-push.sh</string>
    </array>

    <!-- Runs every 60 seconds. Short on purpose: Stage 8b of the pipeline
         (RUNBOOK.md) fetches the just-committed image back from
         raw.githubusercontent.com right after Stage 8a commits it, and
         retries a handful of times rather than failing outright -- keeping
         this interval short keeps that wait (and retry budget) short too. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/armaanmahajan/Library/Logs/memora-outreach-push.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/armaanmahajan/Library/Logs/memora-outreach-push.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
